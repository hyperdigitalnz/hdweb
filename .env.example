# Copy to .env and fill in. Never commit the real .env.

# Cloudflare Turnstile (bot protection on the lead form)
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# GoHighLevel inbound webhook the lead endpoint POSTs to
GHL_WEBHOOK_URL=

# Resend: our own internal "new enquiry" notification, sent from the Worker with every
# form field in it (GHL's workflow email can only be edited by hand in the GHL UI).
# Unset = the notification is silently skipped; leads are unaffected either way.
RESEND_API_KEY=
# Optional overrides. Defaults: from "Hyper Digital website <leads@hyperdigital.nz>",
# to sales@hyperdigital.nz + matt@hyperdigital.nz (comma separated).
LEAD_NOTIFY_FROM=
LEAD_NOTIFY_TO=

# Google Ads conversion (already wired in code from the runlog):
#   gtag id     AW-703611224
#   send_to     AW-703611224/KEGlCPfXyr4cENiCwc8C
