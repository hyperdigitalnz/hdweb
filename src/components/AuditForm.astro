---
// Native lead form → /api/lead (verifies Turnstile → GHL webhook). Progressive enhancement:
// posts via fetch, shows on-page success, fires gtag conversion on verified success.
interface Props {
  title?: string;
  lead?: string;
  /** Show the optional "What's your goal right now?" select. On by default everywhere
   *  (Matt's call, 11/07/2026); pass false to drop it. */
  goal?: boolean;
  /** Show the optional "What's your trade?" select (soft qualification for GHL routing). */
  trade?: boolean;
  /** Trade LPs already know the trade: send it as a hidden field instead of the select. */
  tradePrefill?: string;
}
const {
  title = "Book your free game plan",
  lead = "Tell us about your business and we'll show you where your next jobs are coming from.",
  goal = true,
  trade = true,
  tradePrefill,
} = Astro.props;
import SpeedBadge from "./SpeedBadge.astro";
import Turnstile from "./Turnstile.astro";
---
<!-- Featured-card treatment per DESIGN.md (2px gold at 60%, like the highlighted pricing
     tier) — replaced the old 4px top accent, which broke the documented border vocabulary. -->
<!-- pb-24 below lg: the GHL chat launcher floats over the bottom-right of the mobile
     viewport, so when the card's end is scrolled to rest it was sitting on the submit
     button and Turnstile. The extra tail means the launcher covers padding, not controls. -->
<div class="rounded-box border-2 border-primary/60 bg-base-100 p-6 pb-24 text-base-content shadow-xl sm:p-7 sm:pb-24 lg:pb-7">
  <!-- text-3xl: this was the smallest h2 on the homepage; the ask should never be
     the quietest heading on the page. -->
<h2 class="text-3xl text-base-content">{title}</h2>
  <p class="mt-2 text-sm text-base-content/70">{lead}</p>
  <div class="mt-3"><SpeedBadge tone="light" /></div>

  <form class="audit-form mt-5 grid grid-cols-1 gap-3" method="post" action="/api/lead/">
    <!-- Honeypot: hidden from real users, catches bots. The name/label must never match a
         browser-autofill field type: it was `company` until 11/07/2026 and Chrome's
         "organisation" autofill filled it, silently dropping real leads. -->
    <div class="hidden" aria-hidden="true">
      <label for="af-hp">Leave this field empty</label>
      <input id="af-hp" name="hp_field" type="text" tabindex="-1" autocomplete="off" />
    </div>
    <!-- Source page: tells GHL which page the lead came from (baked in at prerender). -->
    <input type="hidden" name="page" value={Astro.url.pathname} />
    <div class="grid gap-1">
      <label class="text-xs font-bold" for="af-name">Your name</label>
      <input id="af-name" name="name" type="text" required autocomplete="name" placeholder="Jane Smith" class="input input-bordered w-full min-w-0" />
    </div>
    <div class="grid gap-1">
      <label class="text-xs font-bold" for="af-email">Email address</label>
      <input id="af-email" name="email" type="email" required autocomplete="email" placeholder="you@yourbusiness.co.nz" class="input input-bordered w-full min-w-0" />
    </div>
    <div class="grid gap-1">
      <!-- No pattern attribute: NZ numbers vary too much (02x mobiles, 0800, landlines
           with area codes) and a strict pattern would block real leads. -->
      <label class="text-xs font-bold" for="af-phone">Phone number</label>
      <input id="af-phone" name="phone" type="tel" required autocomplete="tel" placeholder="027 123 4567" class="input input-bordered w-full min-w-0" />
    </div>
    <!-- Web presence. Was a single free-text "website or Facebook page" box until
         11/08/2026; it collected too much junk to be useful on a game plan call, so the
         answer is now a forced choice and only the website branch takes a validated URL.
         The Facebook box stays optional: picking the option is already the qualifying
         answer, and a tradie who can't find their page URL must never be blocked. -->
    <fieldset class="grid gap-1">
      <legend class="text-xs font-bold">Do you have a website?</legend>
      <div class="mt-1 grid gap-2 sm:grid-cols-3">
        <label class="af-choice">
          <input type="radio" name="web_presence" value="website" required class="radio radio-sm radio-primary" />
          <span>Yes, a website</span>
        </label>
        <label class="af-choice">
          <input type="radio" name="web_presence" value="facebook" class="radio radio-sm radio-primary" />
          <span>Facebook page only</span>
        </label>
        <label class="af-choice">
          <input type="radio" name="web_presence" value="none" class="radio radio-sm radio-primary" />
          <span>No website yet</span>
        </label>
      </div>
    </fieldset>
    <!-- Revealed by the CSS below (:has on the checked radio), so the right box appears
         even with JavaScript off. `required` is toggled in script: a hidden required
         field makes the browser refuse to submit with nothing focusable to point at. -->
    <div class="af-branch grid gap-1" data-branch="website">
      <label class="text-xs font-bold" for="af-website">Your website address</label>
      <input id="af-website" name="website" type="text" inputmode="url" autocomplete="url" placeholder="yourbusiness.co.nz" class="input input-bordered w-full min-w-0" />
      <p class="text-xs text-base-content/50">Just the address is fine, we'll find the rest.</p>
    </div>
    <div class="af-branch grid gap-1" data-branch="facebook">
      <label class="text-xs font-bold" for="af-social">Your Facebook or Instagram page <span class="font-normal text-base-content/50">(optional)</span></label>
      <input id="af-social" name="social" type="text" inputmode="url" placeholder="facebook.com/yourbusiness" class="input input-bordered w-full min-w-0" />
      <p class="text-xs text-base-content/50">Paste the link to your page, or leave it blank and we'll find it.</p>
    </div>
    <p class="af-branch text-xs text-base-content/50" data-branch="none">
      No problem, plenty of our clients started there. We'll cover it on your game plan call.
    </p>
    {tradePrefill ? (
      <input type="hidden" name="trade" value={tradePrefill} />
    ) : trade && (
      <div class="grid gap-1">
        <label class="text-xs font-bold" for="af-trade">What's your trade? <span class="font-normal text-base-content/50">(optional)</span></label>
        <select id="af-trade" name="trade" class="select select-bordered w-full min-w-0">
          <option value="" disabled selected>Select one…</option>
          <option>Plumber</option>
          <option>Electrician</option>
          <option>Roofer</option>
          <option>Builder</option>
          <option>Painter</option>
          <option>HVAC / heat pumps</option>
          <option>Other trade</option>
          <option>Not a trade business</option>
        </select>
      </div>
    )}
    {goal && (
      <div class="grid gap-1">
        <label class="text-xs font-bold" for="af-goal">What's your goal right now? <span class="font-normal text-base-content/50">(optional)</span></label>
        <select id="af-goal" name="goal" class="select select-bordered w-full min-w-0">
          <option value="" disabled selected>Select one…</option>
          <option>More leads</option>
          <option>A new website</option>
          <option>More reviews / repeat work</option>
          <option>Not sure yet</option>
        </select>
      </div>
    )}

    <Turnstile />

    <button type="submit" class="btn btn-primary btn-block font-display text-lg tracking-wide">Get my free game plan →</button>
    <p class="form-msg text-center text-xs text-base-content/60" aria-live="polite">
      20 minutes with Ryan or Matt, real numbers, no obligation. We only take on a handful of new
      clients a month.
    </p>
  </form>
</div>

<style>
  /* Choice tiles. Plain labels with a border so the whole tile is a tap target,
     which matters more than looks on a phone-first form. */
  .af-choice {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    border-radius: var(--radius-field);
    border: 1px solid var(--color-base-300);
    padding: 0.625rem 0.75rem;
    font-size: 0.875rem;
    line-height: 1.25rem;
  }
  .af-choice:hover { border-color: var(--color-primary); }
  .af-choice:has(input:checked) {
    border-color: var(--color-primary);
    background-color: color-mix(in oklab, var(--color-primary) 8%, transparent);
    font-weight: 600;
  }
  .af-choice:has(input:focus-visible) { outline: 2px solid var(--color-primary); outline-offset: 2px; }

  /* CSS-only branch reveal, so the correct follow-up shows with JavaScript off too.
     Not the `hidden` attribute: Tailwind preflight styles [hidden] with !important. */
  .af-branch { display: none; }
  .audit-form:has(input[name="web_presence"][value="website"]:checked) .af-branch[data-branch="website"] { display: grid; }
  .audit-form:has(input[name="web_presence"][value="facebook"]:checked) .af-branch[data-branch="facebook"] { display: grid; }
  .audit-form:has(input[name="web_presence"][value="none"]:checked) .af-branch[data-branch="none"] { display: block; }
</style>

<script>
  import { SITE } from "../consts";
  import { normaliseWebsite, normaliseSocial, WEBSITE_MESSAGES, SOCIAL_MESSAGE } from "../lib/web-presence";

  function wireForms() {
    document.querySelectorAll<HTMLFormElement>(".audit-form").forEach((form) => {
      if (form.dataset.wired) return;
      form.dataset.wired = "1";

      // Web presence branches. The stylesheet does the showing and hiding (so it works
      // with JS off); this adds the parts CSS can't express: making the website box
      // genuinely required, disabling the boxes that aren't in play so a value typed and
      // then abandoned never rides along, and checking the format with the same rules
      // the server re-applies in /api/lead.
      const presence = Array.from(form.querySelectorAll<HTMLInputElement>('input[name="web_presence"]'));
      const websiteInput = form.querySelector<HTMLInputElement>('input[name="website"]');
      const socialInput = form.querySelector<HTMLInputElement>('input[name="social"]');

      const checkWebsite = () => {
        if (!websiteInput || websiteInput.disabled) return;
        const raw = websiteInput.value.trim();
        if (!raw) return websiteInput.setCustomValidity(WEBSITE_MESSAGES.empty);
        const result = normaliseWebsite(raw);
        websiteInput.setCustomValidity(result.ok ? "" : WEBSITE_MESSAGES[result.reason]);
      };

      const checkSocial = () => {
        if (!socialInput || socialInput.disabled) return;
        // Blank is valid here on purpose, so this only ever fires on a real typo.
        socialInput.setCustomValidity(normaliseSocial(socialInput.value).ok ? "" : SOCIAL_MESSAGE);
      };

      const applyBranch = () => {
        const picked = presence.find((r) => r.checked)?.value ?? "";
        for (const [input, branch] of [[websiteInput, "website"], [socialInput, "facebook"]] as const) {
          if (!input) continue;
          const live = picked === branch;
          // Disabled controls are left out of FormData and skipped by validation, which
          // is exactly what a hidden branch should be.
          input.disabled = !live;
          if (!live) input.setCustomValidity("");
        }
        if (websiteInput) websiteInput.required = picked === "website";
        checkWebsite();
        checkSocial();
      };

      presence.forEach((radio) => radio.addEventListener("change", applyBranch));
      websiteInput?.addEventListener("input", checkWebsite);
      socialInput?.addEventListener("input", checkSocial);
      // Runs now as well as on change: bfcache and Firefox's form restore can hand us a
      // radio that's already checked without ever firing an event.
      applyBranch();

      // Gate submit on Turnstile readiness: the api.js loader is deferred, so a fast
      // submitter on a slow connection could otherwise post without a token and get a
      // generic failure. JS-only by design (no-JS keeps a live button and the server
      // now redirects failures to an explanatory notice). The 8s fallback re-enables
      // the button if the Turnstile script never arrives (blocked/offline), so the
      // form is never bricked; the server-side check still has the final say.
      const btn0 = form.querySelector<HTMLButtonElement>("button[type=submit]");
      if (btn0 && form.querySelector(".cf-turnstile")) {
        const readyLabel = btn0.textContent;
        const setReady = (ready: boolean) => {
          btn0.disabled = !ready;
          btn0.textContent = ready ? readyLabel : "Loading secure check…";
        };
        setReady(false);
        const fallback = window.setTimeout(() => setReady(true), 8000);
        form.addEventListener("turnstile:token", () => { clearTimeout(fallback); setReady(true); });
        form.addEventListener("turnstile:expired", () => setReady(false));
      }

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        const msg = form.querySelector<HTMLElement>(".form-msg");
        const btn = form.querySelector<HTMLButtonElement>("button[type=submit]");
        if (btn) { btn.disabled = true; btn.textContent = "Sending…"; }
        try {
          const fd = new FormData(form);
          // If the visitor used the job calculator, their numbers ride along in the
          // `message` field (already in the API allow-list) so the game plan call can
          // open with them on the table. Set by JobCalculator.astro.
          try {
            const calc = sessionStorage.getItem("af_calc");
            if (calc && !fd.get("message")) fd.append("message", calc.slice(0, 480));
          } catch (e) { /* storage disabled — fine */ }
          const res = await fetch(form.action, { method: "POST", body: fd });
          const data = (await res.json().catch(() => ({ ok: res.ok }))) as { ok?: boolean; error?: string };
          if (data.ok) {
            // Stash a few fields to prefill the GHL calendar on /thank-you. Kept in
            // sessionStorage (not the URL) so it never hits our history or server logs;
            // it only ends up in the cross-origin booking iframe, where it has to go.
            try {
              sessionStorage.setItem("af_prefill", JSON.stringify({
                name: String(fd.get("name") || ""),
                email: String(fd.get("email") || ""),
                phone: String(fd.get("phone") || ""),
                website: String(fd.get("website") || ""),
              }));
            } catch (e) { /* private mode / storage disabled — prefill just won't apply */ }
            // Verified server-side → send them to the thank-you page (fires the conversion there).
            window.location.assign("/thank-you");
          } else {
            throw new Error(data.error || "failed");
          }
        } catch (err) {
          // Static markup only (no user input) so innerHTML is safe; the phone number
          // must be a tappable tel: link, this is a phone-first audience.
          if (msg) {
            msg.innerHTML = `That didn't send. Give it another go, or call Matt or Ryan on <a class="link font-semibold whitespace-nowrap" href="${SITE.phoneHref}">${SITE.phone}</a>.`;
            msg.classList.add("text-error");
          }
          if (btn) { btn.disabled = false; btn.textContent = "Get my free game plan →"; }
          // The widget token is single-use; reset it so an immediate retry can pass siteverify.
          const widget = form.querySelector<HTMLElement>(".cf-turnstile");
          if (widget) (window as any).turnstile?.reset?.(widget);
        }
      });
    });
  }
  document.addEventListener("astro:page-load", wireForms);
</script>
