---
// Author bio card, rendered at the foot of every insights article and the two
// local guide pages. Identity lives in AUTHOR (src/consts.ts), not here.
import { AUTHOR } from "../consts";
---
<aside class="rounded-box border border-base-300 bg-base-200 p-6 sm:p-7" aria-label="About the author">
  <div class="flex flex-col items-start gap-5 sm:flex-row sm:items-center">
    <img
      src={AUTHOR.photo}
      alt={AUTHOR.name}
      loading="lazy"
      width="96"
      height="96"
      class="h-20 w-20 shrink-0 rounded-full object-cover"
    />
    <div>
      <span class="eyebrow">Written by</span>
      <div class="font-display text-xl">{AUTHOR.name}</div>
      <div class="text-sm text-base-content/60">{AUTHOR.role}</div>
      <p class="mt-2 text-base-content/70">{AUTHOR.bio}</p>
      <div class="mt-3 flex flex-wrap gap-x-5 gap-y-1 text-sm">
        <a href={AUTHOR.linkedin} target="_blank" rel="me noopener" class="link text-primary">LinkedIn</a>
        <a href={AUTHOR.website} target="_blank" rel="me noopener" class="link text-primary">mattmcauliffe.co.nz</a>
      </div>
    </div>
  </div>
</aside>
