---
// "Take the deposit while they're still keen" — payments capability block.
// Capability list confirmed in the platform doc (ghl-chatbot-training.md, 24/07/2026):
// card payments on bookings, invoices and payment links, Apple Pay / Google Pay,
// Stripe or PayPal, Xero / QuickBooks. Used on /websites and /ai-automation.
import Reveal from "./Reveal.astro";
import Icon from "./Icon.astro";

const points = [
  { icon: "dollar", title: "Card payments on bookings", body: "Handy for a deposit or a call-out fee, taken the moment the job books instead of chased later." },
  { icon: "mail", title: "Invoices and payment links", body: "Send a payment link with the confirmation, and take Apple Pay and Google Pay too." },
  { icon: "repeat", title: "Plugs into your setup", body: "Works with Stripe or PayPal, and connects to Xero or QuickBooks if that's where your invoicing lives." },
];
---
<section class="py-16 sm:py-20">
  <div class="mx-auto max-w-[1160px] px-5">
    <Reveal class="mx-auto max-w-2xl text-center">
      <span class="eyebrow">Get paid faster</span>
      <h2 class="mt-2 text-3xl sm:text-4xl">Take the deposit while they're still keen.</h2>
      <p class="mx-auto mt-4 max-w-2xl text-base-content/80">
        For bigger jobs, the gap between "yes" and the deposit is where work falls over. Your
        system can take payment at the moment of booking, so the job is locked in before you've
        even picked up the phone.
      </p>
    </Reveal>
    <div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-3">
      {points.map((p, i) => (
        <Reveal delay={i * 0.08} class="h-full">
          <div class="card card-glow h-full border border-base-300 bg-base-100 shadow-sm">
            <div class="card-body">
              <span class="icon-chip"><Icon name={p.icon} class="h-6 w-6" /></span>
              <h3 class="mt-3 font-display text-xl">{p.title}</h3>
              <p class="mt-1 text-base-content/70">{p.body}</p>
            </div>
          </div>
        </Reveal>
      ))}
    </div>
  </div>
</section>
