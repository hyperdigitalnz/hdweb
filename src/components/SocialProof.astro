---
// Avatar stack + real Google-review badge (fa.st-style social proof row).
// The stars are anchored to the actual review count in consts.ts (REVIEWS), never
// a bare unsourced row; the client count is the confirmed 107-since-2019 figure.
import { REVIEWS } from "../consts";

interface Props {
  tone?: "dark" | "light";
}
const { tone = "dark" } = Astro.props;
const ring = tone === "dark" ? "ring-neutral" : "ring-base-100";
const sub = tone === "dark" ? "text-neutral-content/80" : "text-base-content/70";
const strong = tone === "dark" ? "text-neutral-content" : "text-base-content";

const avatars = [
  { src: "/img/denise-bermuda-lifestyle-avatar.webp", alt: "Denise, Bermuda Lifestyle" },
  { src: "/img/tableau-towbars-avatar.webp", alt: "Tableau Towbars" },
  { src: "/img/harris-pumps-avatar.webp", alt: "Harris Pumps" },
  { src: "/img/continous-spouting-avatar.webp", alt: "Continuous Spouting" },
  { src: "/img/wade-motordrome-avatar.webp", alt: "Wade, Motordrome" },
];
---
<div class="flex flex-wrap items-center justify-center gap-x-3 gap-y-2">
  <div class="flex -space-x-3">
    {avatars.map((a) => (
      <img
        src={a.src}
        alt={a.alt}
        width="96"
        height="96"
        loading="lazy"
        decoding="async"
        class={`h-10 w-10 rounded-full object-cover object-center bg-neutral ring-2 ${ring}`}
      />
    ))}
  </div>
  <a href={REVIEWS.url} target="_blank" rel="noopener" class="text-left">
    <div class="leading-none text-primary" aria-hidden="true">★★★★★</div>
    <div class={`mt-0.5 text-sm ${sub}`}>
      <span class={`font-bold ${strong}`}>{REVIEWS.rating}</span> from {REVIEWS.count} Google reviews
    </div>
    <div class={`text-sm ${sub}`}>
      <span class={`font-bold ${strong}`}>107</span> Kiwi businesses since 2019
    </div>
  </a>
</div>
