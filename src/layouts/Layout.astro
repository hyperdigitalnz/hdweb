---
import "../styles/global.css";
// Self-hosted font: Outfit variable (all weights, registers "Outfit Variable").
// SVG chart labels also use Outfit now; the old Source Sans 3 import is gone
// (it pulled every subset into the global CSS for a handful of chart labels).
import "@fontsource-variable/outfit";
import outfitWoff2 from "@fontsource-variable/outfit/files/outfit-latin-wght-normal.woff2?url";
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE } from "../consts";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  /** Hide the site nav header. Used on paid-traffic landing pages to remove
   *  exit links and keep focus on the form. */
  hideHeader?: boolean;
  /** Hide the footer too. Used by chrome-free utility pages like /links. */
  hideFooter?: boolean;
  /** Hide the chat widget. The 404 page must set this explicitly because it
   *  renders under the requested (missing) URL, not a fixed path. */
  hideChat?: boolean;
}
const {
  title = `${SITE.name} | ${SITE.tagline}`,
  description = "The complete job booking system for modern Tradies. We find you the work, reply to every enquiry 24/7, and keep your calendar full. Free game plan.",
  image = "/img/digital-marketing.png",
  noindex = false,
  hideHeader = false,
  hideFooter = false,
  hideChat = false,
} = Astro.props;

// Absolute URLs for canonical + social cards (needs `site` in astro.config).
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;

// Chat widget shows everywhere except these pages. ClientRouter swaps each
// page's server-rendered body on navigation, so this per-path check stays
// correct without client-side logic.
const noChatPaths = ["/privacy", "/terms", "/thank-you", "/404"];
const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
const showChat = !hideChat && !noChatPaths.includes(currentPath);
---
<!doctype html>
<html lang="en-NZ" data-theme="hyper">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon-48.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0c0b0a" />
    <!-- Insights feed, for RSS readers and news/AI aggregators. -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Hyper Digital Insights"
      href="/rss.xml"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_NZ" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Preload the display font: the LCP element (header logo text) renders in it,
         so having it by first paint avoids a late font-swap repaint. -->
    <link rel="preload" as="font" type="font/woff2" crossorigin href={outfitWoff2} />

    <ClientRouter />

    <!-- Third-party loading (GTM-KXHVKNQ, Google Ads gtag AW-703611224, GHL chat).
         The dataLayer/gtag stubs are eager so any queued call (incl. the /thank-you
         conversion) fires once the libraries load. The heavy scripts themselves load on
         the FIRST USER INTERACTION (scroll/touch/pointer/key), which keeps them out of
         the Lighthouse trace and off the critical path. Two deliberate exceptions:
         /thank-you loads everything immediately (the Ads conversion fires there and must
         never wait on an interaction), and no-JS users still get the GTM noscript iframe.
         Trade-off (accepted 25/07/2026): GA4 no longer counts visitors who leave without
         a single interaction. Converting users always interact, so conversion tracking
         and gclid capture are unaffected. Tag changes still happen in the GTM UI, not here. -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag("js", new Date());
      gtag("config", "AW-703611224");

      (function () {
        if (window.__hd3p) return;
        window.__hd3p = true;
        var loaded = false;
        function loadThirdParties() {
          if (loaded) return;
          loaded = true;
          ["pointerdown", "touchstart", "keydown", "scroll", "mousemove"].forEach(function (t) {
            removeEventListener(t, loadThirdParties, { capture: true });
          });
          // GTM container (FB pixel, GA4, Clarity/Hotjar etc. all live inside GTM)
          window.dataLayer.push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
          var g = document.createElement("script");
          g.async = true;
          g.src = "https://www.googletagmanager.com/gtm.js?id=GTM-KXHVKNQ";
          document.head.appendChild(g);
          // Google Ads gtag library (config already queued above)
          var a = document.createElement("script");
          a.async = true;
          a.src = "https://www.googletagmanager.com/gtag/js?id=AW-703611224";
          document.head.appendChild(a);
          injectChat();
        }
        var chatInjected = false;
        function injectChat() {
          // Only on pages that want it (body flag set server-side); re-checked after
          // view transitions so landing on a no-chat page doesn't suppress it forever.
          if (chatInjected || !document.body || document.body.dataset.chatWidget !== "1") return;
          chatInjected = true;
          var c = document.createElement("script");
          c.async = true;
          c.src = "https://widgets.leadconnectorhq.com/loader.js";
          c.setAttribute("data-resources-url", "https://widgets.leadconnectorhq.com/chat-widget/loader.js");
          c.setAttribute("data-widget-id", "695ff09578e0acf0ed3bf73d");
          document.body.appendChild(c);
        }
        document.addEventListener("astro:page-load", function () {
          if (loaded) injectChat();
        });
        if (location.pathname.replace(/\/+$/, "") === "/thank-you") {
          // Conversion page: load immediately (after DOM is ready so body exists).
          if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", loadThirdParties);
          } else {
            loadThirdParties();
          }
        } else {
          ["pointerdown", "touchstart", "keydown", "scroll", "mousemove"].forEach(function (t) {
            addEventListener(t, loadThirdParties, { capture: true, passive: true, once: false });
          });
        }
      })();
    </script>

    <!-- mark JS available so reveal elements can hide pre-animation (no FOUC for no-JS) -->
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>
  <!-- data-chat-widget (not data-chat: that selector belongs to ChatDemo's bubbles) -->
  <body class="bg-base-100 text-base-content" data-chat-widget={showChat ? "1" : undefined}>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-KXHVKNQ"
      height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <!-- Skip link: invisible until keyboard-focused, then a gold button top-left. -->
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-[100] btn btn-primary btn-sm font-display tracking-wide">
      Skip to content
    </a>
    {!hideHeader && <Header />}
    <main id="main">
      <slot />
    </main>
    {!hideFooter && <Footer />}

    <!-- DO NOT mount anything fixed to the bottom of the mobile viewport here (a sticky
         call/callback bar lived here briefly on 03/07/2026 and was removed): the GHL
         chatbot embed below occupies that area on mobile and blocks/covers it. -->

    <!-- LeadConnector chat widget: injected by the third-party loader in <head> on first
         interaction, gated by the body's data-chat flag (off on privacy, terms,
         thank-you, 404). No script tag here on purpose. -->

    <!-- Scroll-reveal animations via Motion (re-runs after view transitions) -->
    <script>
      import { animate, inView } from "motion";

      function setupReveal() {
        const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        document.querySelectorAll<HTMLElement>("[data-reveal]").forEach((el) => {
          if (el.dataset.revealed) return;
          el.dataset.revealed = "1";
          // JS is in charge now: cancel the CSS forceVisible fallback so items below the
          // fold don't pop in at 3s and then re-animate when scrolled into view.
          el.style.animation = "none";
          if (reduce) { el.style.opacity = "1"; el.style.transform = "none"; return; }
          const delay = parseFloat(el.dataset.revealDelay || "0");
          inView(
            el,
            () => {
              animate(
                el,
                { opacity: [0, 1], transform: ["translateY(16px)", "translateY(0px)"] },
                { duration: 0.6, delay, ease: [0.16, 1, 0.3, 1] }
              );
            },
            { amount: 0.2 }
          );
        });
      }
      // Run immediately: this module executes right after DOM parse, so reveals start at
      // first paint instead of waiting for astro:page-load (which fires only after the full
      // load event, third-party scripts included). The listener re-runs it after view
      // transitions; setupReveal itself is idempotent via data-revealed.
      setupReveal();
      document.addEventListener("astro:page-load", setupReveal);
    </script>
  </body>
</html>
