---
import Layout from "../layouts/Layout.astro";
import Reveal from "../components/Reveal.astro";
import Icon from "../components/Icon.astro";
import AuditForm from "../components/AuditForm.astro";
import SocialProof from "../components/SocialProof.astro";
import PricingTiers from "../components/PricingTiers.astro";
import SpeedBadge from "../components/SpeedBadge.astro";
import BookedWeek from "../components/BookedWeek.astro";
import ChatDemo from "../components/ChatDemo.astro";
import JobCalculator from "../components/JobCalculator.astro";
import { SITE, STATS } from "../consts";
import { SETUP_FEE } from "../data/pricing";

const trades = [
  { name: "Plumbers", icon: "droplet" },
  { name: "Electricians", icon: "bolt" },
  { name: "Roofers", icon: "home" },
  { name: "Builders", icon: "hammer" },
  { name: "HVAC & Air Con", icon: "flame" },
  { name: "Painters", icon: "paint" },
  { name: "Auto & Mechanical", icon: "cog" },
  { name: "Drainlayers", icon: "wrench" },
  { name: "Landscapers", icon: "leaf" },
  { name: "Concrete", icon: "blocks" },
];

const missed = [
  { icon: "phone-missed", title: "Missed call", meta: "Unknown number · 9:47am", tilt: "-rotate-2" },
  { icon: "voicemail", title: "Voicemail", meta: "No message left · 11:15am", tilt: "rotate-1" },
  { icon: "phone-missed", title: "Missed call", meta: "While you were quoting · 11:52am", tilt: "-rotate-1" },
];

// Rows pair 1:1 with `withUs` (the two cards read as a comparison), so each row
// must answer the SAME subject as its opposite number, and row 1 must never imply
// we answer phone calls automatically (lead-response rules in CLAUDE.md).
const alone = [
  "Enquiries sit unanswered while you're on the tools.",
  "Quotes you meant to chase, but never did.",
  "Ad money spent with nothing to show for it.",
  "Happy customers who never leave a review.",
  "Marketing decisions made by gut feel at 9pm.",
];

const withUs = [
  "Every website enquiry gets an instant reply, day or night.",
  "Leads followed up automatically until they book or say no.",
  "Every ad dollar tracked, reported and accounted for.",
  "Reviews requested after every job, on autopilot.",
  "Real numbers reported every month, so you know what's working.",
];

type SystemCard = {
  n: string;
  icon: string;
  title: string;
  body: string;
  link?: { href: string; label: string };
};

const system: SystemCard[] = [
  {
    n: "01",
    icon: "target",
    title: "Find the work",
    body: "Tight Google Ads campaigns put you in front of ready-to-buy locals the moment they search. Local SEO keeps you climbing over time. Real calls and quote requests, not vanity clicks.",
    // Exact-match anchor into the ads page. The homepage was ranking for
    // "google ads agency" style queries with nothing relevant to land on;
    // this is the signal that /google-ads is the better match.
    link: { href: "/google-ads", label: "Google Ads management" },
  },
  {
    n: "02",
    icon: "calendar-check",
    title: "Book the work",
    body: "Your smart website and AI assistant reply on the spot, gather the details you need to quote, and book in on-site jobs or a call back. Even at 11pm, while you're off the clock.",
    // Keyword-matched anchor, same idea as card 01 → /google-ads.
    link: { href: "/websites", label: "Smart websites for tradies" },
  },
  {
    n: "03",
    icon: "repeat",
    title: "Keep it coming",
    body: "Automatic follow-ups chase every quote until it's a yes or a no. Reviews roll in after every job. Past customers get a nudge when it's time to book again.",
    link: { href: "/ai-automation", label: "AI automation for tradies" },
  },
];

const steps = [
  {
    n: "1",
    title: "The free game plan",
    body: "We look at your trade, your area and your competition, then give you real numbers on what's possible. No jargon, no pressure.",
  },
  {
    n: "2",
    title: "We build your system",
    body: "Smart website, campaigns, automation. Built and switched on within days, without you lifting a finger.",
  },
  {
    n: "3",
    title: "Your phone starts ringing",
    body: "Booked jobs land in your calendar. We report the real numbers every month and keep tuning to bring your cost per job down.",
  },
];

const clientLogos = [
  { src: "/img/continuousGroupLogoBW.png", alt: "Continuous Group", w: 300, h: 180 },
  { src: "/img/no-drips-logo.png", alt: "No Drips Waterproofing", w: 329, h: 247 },
  { src: "/img/boulevardServicesLogoBW.png", alt: "Boulevard Services", w: 300, h: 180 },
  // White logo, invisible on the light section background — gets a dark backing box.
  { src: "/img/harcourtsLogoBW.png", alt: "Harcourts", darkBox: true, w: 297, h: 74 },
  { src: "/img/portaSkipLogoBW.png", alt: "Porta Skip", w: 250, h: 116 },
  { src: "/img/toplineLogoBW.png", alt: "Topline", w: 300, h: 180 },
  { src: "/img/hawksBayCombinedTaxisLogoBW.png", alt: "Hawke's Bay Combined Taxis", w: 300, h: 180 },
];

const faqs = [
  { q: "How many leads will I actually get?", a: "It depends on your trade, your area and your budget, which is exactly what your free game plan works out. We give you realistic numbers up front, and report on real calls and quote requests every month." },
  { q: "What if you don't hit my goal?", a: "We keep working and waive our management fee until we do. We agree the target with you before we start, so there are no surprises." },
  { q: "Is there a lock-in contract? What happens if I leave?", a: "No lock-in. We ask for one month's notice when you cancel, and there's a simple reason: ad spend can roll over from month to month, so the notice month lets us clear anything that's carried over and hand your account over clean. Everything we've built for your marketing is yours: the Google Ads campaigns, the Meta campaigns, the landing pages, the conversion tracking. All of it transfers to you in full, along with your domain, your Google Business Profile and your customer list. No exit fee, no argument." },
  { q: "Do I have to pay upfront?", a: `Yes. We take the ${SETUP_FEE} +GST setup and your first month before we start. We're a small Kiwi agency and we don't float thousands of dollars before we've earned your trust. We back it with our 60-day guarantee instead.` },
  { q: "What's included in the monthly price?", a: "Your smart website, our ad management and the automation that turns clicks into booked jobs. Your ad budget is the one thing that's separate, set to suit your goals, so every dollar works for you." },
  { q: "What if I get too busy?", a: "Good problem, and a real one. We agree your monthly lead target before we start and we can throttle the ad spend up or down any month. Plenty of our clients dial it back over summer and open it up again when they've got capacity. You're never stuck paying for leads you can't service." },
  { q: "How soon can I start getting leads?", a: "Most campaigns are live within days of your game plan call, with leads coming in shortly after. We tune everything over the first few weeks to bring your cost per lead down." },
];
---
<Layout
  title="Digital Marketing for NZ Tradies | Google Ads, Websites & Automation | Hyper Digital"
  description="Google Ads, smart websites and automation that get NZ tradies more booked jobs. Every enquiry gets an instant reply, 24/7. From $497 +GST/mo. Free 20-minute game plan."
>
  <!-- ===== HERO ===== -->
  <section class="bg-brand-dark text-neutral-content">
    <div class="mx-auto grid max-w-[1200px] items-center gap-14 px-5 py-16 sm:py-20 lg:grid-cols-[1.12fr_0.88fr] lg:py-24">
      <div class="min-w-0 text-center lg:text-left">
        <Reveal instant>
          <span class="inline-flex items-center gap-2 rounded-full border border-primary/40 bg-primary/10 px-4 py-1.5 text-sm font-semibold text-primary">
            <Icon name="sparkles" class="h-4 w-4" /> NZ's job booking system for tradies
          </span>
        </Reveal>
        <Reveal instant delay={0.05} class="mt-6">
          <!-- aria-label: the visual text runs together in the accessible name (block
               spans add no spaces) and the rotator rewrites it every 3s. Screen readers
               get one stable, generic sentence instead. -->
          <h1 class="text-4xl sm:text-6xl xl:text-7xl" aria-label="The system that keeps tradies booked solid.">
            <span class="block text-[0.66em]">The system that keeps</span>
            <span class="block"><span class="marker rotator" data-rotate>Electricians</span></span>
            <span class="block">booked solid.</span>
          </h1>
        </Reveal>
        <Reveal instant delay={0.1} class="mx-auto mt-6 max-w-xl lg:mx-0">
          <p class="text-lg text-neutral-content/80">
            We find the work, reply to every enquiry the moment it lands, and get each job booked
            in or teed up to quote while you're flat out on the tools. You just pick up where the
            system leaves off.
          </p>
        </Reveal>
        <!-- SocialProof sits ABOVE the CTA pair: on a phone, whatever ends the hero
             lands in the bottom-right of the first viewport, where the GHL chat bubble
             floats. The review/client proof was being covered there (critique 30/07);
             the full-width CTAs and the small centred SpeedBadge tolerate the overlap. -->
        <Reveal instant delay={0.15} class="mt-7 flex justify-center lg:justify-start">
          <SocialProof />
        </Reveal>
        <Reveal instant delay={0.2} class="mt-7 flex flex-col flex-wrap justify-center gap-3 sm:flex-row lg:justify-start">
          <a href="#audit" class="btn btn-primary btn-lg btn-shine w-full font-display text-lg tracking-wide shadow-lg shadow-primary/30 transition-transform hover:scale-[1.03] sm:w-auto">
            Get my free game plan <Icon name="arrow-right" class="h-5 w-5" />
          </a>
          <a href="#how" class="btn btn-outline btn-lg w-full border-white/60 text-white hover:border-white hover:bg-white hover:text-neutral font-display text-lg tracking-wide sm:w-auto">
            See how it works
          </a>
        </Reveal>
        <Reveal instant delay={0.26} class="mt-6 flex justify-center lg:justify-start">
          <SpeedBadge tone="dark" />
        </Reveal>
      </div>

      <Reveal instant delay={0.2} class="relative min-w-0">
        <div class="glow-blob"></div>
        <div class="float-slow relative">
          <BookedWeek />
        </div>
      </Reveal>
    </div>

    <!-- Slim stat row closes the hero band (the old light trust-bar band is folded in
         here). "107" and "5.0" stay out of this row: both already render in the
         SocialProof block above, and 107/49 must never share a section anyway. -->
    <div class="border-t border-white/10">
      <div class="mx-auto flex max-w-[1160px] flex-wrap items-baseline justify-center gap-x-10 gap-y-3 px-5 py-5">
        {STATS.slice(1, 4).map((s) => (
          <div class="flex flex-col items-center gap-0.5 text-center sm:flex-row sm:items-baseline sm:gap-2">
            <span class="font-display text-2xl text-neutral-content sm:text-3xl">{s.value}</span>
            <span class="text-sm text-neutral-content/60">{s.label}</span>
          </div>
        ))}
      </div>
      {/* The 4x asterisk resolves in the footer's STATS_NOTE line, the site's
          standing pattern; repeating the full sentence here doubled it up. */}
    </div>
  </section>

  <!-- ===== TRADES MARQUEE ===== -->
  <div class="border-b border-base-300 bg-neutral py-4 text-neutral-content">
    <!-- Static list for screen readers; the moving strip below duplicates every
         trade for the loop and would be read twice. -->
    <p class="sr-only">Trades we work with: {trades.map((t) => t.name).join(", ")}.</p>
    <div class="marquee-wrap" aria-hidden="true">
      <div class="marquee">
        {[...trades, ...trades].map((t) => (
          <span class="mx-4 inline-flex items-center gap-2.5 font-display text-base font-semibold uppercase tracking-wide text-neutral-content/60 sm:mx-7 sm:text-lg">
            <Icon name={t.icon} class="h-5 w-5 text-primary" /> {t.name}
          </span>
        ))}
      </div>
    </div>
  </div>

  <!-- ===== PAIN: THE LEAK ===== -->
  <section class="py-16 sm:py-24">
    <div class="mx-auto grid max-w-[1160px] items-center gap-12 px-5 lg:grid-cols-2">
      <div class="text-center lg:text-left">
        <Reveal><span class="eyebrow">The leak</span></Reveal>
        <Reveal delay={0.05} class="mx-auto max-w-2xl lg:mx-0 lg:max-w-none">
          <h2 class="mt-3 text-3xl sm:text-5xl">Every missed call is a job for the <span class="highlight">other guy</span>.</h2>
        </Reveal>
        <Reveal delay={0.1} class="mx-auto max-w-xl lg:mx-0">
          <p class="mt-6 text-lg text-base-content/70">
            You're up a ladder or under a house. The phone rings out. By the time you check it at
            smoko, they've rung the next name on Google and booked him in.
          </p>
        </Reveal>
        <Reveal delay={0.15} class="mx-auto max-w-xl lg:mx-0">
          <p class="mt-4 text-lg font-bold text-base-content">It's quietly costing you real, winnable jobs every single week.</p>
        </Reveal>
      </div>

      <div class="mx-auto w-full max-w-sm space-y-4">
        {missed.map((c, i) => (
          <Reveal delay={0.1 + i * 0.12}>
            <div class={`flex items-center gap-4 rounded-2xl border border-error/20 bg-base-100 p-4 shadow-lg ${c.tilt}`}>
              <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-error/10 text-error">
                <Icon name={c.icon} class="h-5 w-5" />
              </span>
              <div class="min-w-0">
                <p class="font-display text-lg">{c.title}</p>
                <p class="text-sm text-base-content/60">{c.meta}</p>
              </div>
            </div>
          </Reveal>
        ))}
        <Reveal delay={0.5}>
          <p class="pt-1 text-center text-sm text-base-content/60">
            Three missed calls is a normal morning. Any one of them could've been next week's biggest job.
          </p>
        </Reveal>
      </div>
    </div>

    <!-- The fix reads directly under the pain it answers (was its own "difference"
         band with a "Two ways to run a trade business" header; merged 30/07/2026). -->
    <div class="mx-auto max-w-[1000px] px-5">
      {/* Mobile: the two cards stacked put pain and fix ~2 screens apart, so the
          comparison never fired (critique 30/07). Interleave each pain with its fix
          so the contrast happens inside one thumb-scroll. Desktop keeps the cards. */}
      <Reveal class="mt-12 md:hidden">
        <div class="card border border-base-300 bg-base-100">
          <div class="card-body">
            <div class="flex flex-wrap gap-x-5 gap-y-1 text-sm font-semibold">
              <span class="inline-flex items-center gap-1.5 text-base-content/60">
                <Icon name="x" class="h-4 w-4 text-error" /> Doing it all yourself
              </span>
              <span class="inline-flex items-center gap-1.5">
                <Icon name="check" class="h-4 w-4 text-primary" /> Running our system
              </span>
            </div>
            <ul class="mt-2 divide-y divide-base-300">
              {alone.map((pain, i) => (
                <li class="py-4 last:pb-0">
                  <p class="flex items-start gap-3 text-base-content/60">
                    <Icon name="x" class="mt-1 h-4 w-4 shrink-0 text-error" /> {pain}
                  </p>
                  <p class="mt-2 flex items-start gap-3 font-semibold">
                    <Icon name="check" class="mt-1 h-4 w-4 shrink-0 text-primary" /> {withUs[i]}
                  </p>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </Reveal>

      <div class="mt-12 hidden grid-cols-1 gap-6 md:grid md:grid-cols-2">
        <Reveal>
          <div class="card h-full border border-base-300 bg-base-100">
            <div class="card-body">
              <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-error/10 text-error">
                <Icon name="phone-missed" class="h-5 w-5" />
              </span>
              <h3 class="mt-3 text-2xl">Doing it all yourself</h3>
              <ul class="mt-3 space-y-3 text-base-content/70">
                {alone.map((item) => (
                  <li class="flex gap-3">
                    <Icon name="x" class="mt-1 h-4 w-4 shrink-0 text-error" /> {item}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </Reveal>
        <Reveal delay={0.08}>
          <div class="card card-glow h-full border-2 border-primary/60 bg-brand-dark text-neutral-content shadow-xl">
            <div class="card-body">
              <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-primary/15 text-primary">
                <Icon name="bolt" class="h-5 w-5" />
              </span>
              <h3 class="mt-3 text-2xl text-neutral-content">Running the Hyper Digital system</h3>
              <ul class="mt-3 space-y-3 text-neutral-content/80">
                {withUs.map((item) => (
                  <li class="flex gap-3">
                    <Icon name="check" class="mt-1 h-4 w-4 shrink-0 text-primary" /> {item}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </Reveal>
      </div>
    </div>
  </section>

  <!-- ===== BURNED BEFORE (objection: "I've paid an agency and got nothing").
       Position 3 in the arc (moved up from post-proof, 30/07/2026): the confession is
       the hinge of the page and earns display-scale type - one of only two H2s
       allowed to step up to the hero's scale. ===== -->
  <section class="bg-brand-dark text-neutral-content">
    <div class="mx-auto max-w-[1000px] px-5 py-16 sm:py-24">
      <Reveal class="text-center">
        <span class="eyebrow">Been burned before?</span>
        <h2 class="mt-3 text-4xl text-neutral-content sm:text-6xl">
          If your last agency left a bad taste, <span class="marker">read this</span>.
        </h2>
        <p class="mx-auto mt-6 max-w-2xl text-lg text-neutral-content/80">
          Most tradies we talk to have already paid an agency and got nothing back. Usually the
          same story: a monthly report full of clicks and impressions, no way to tell if a single
          job came from it, and a contract you can't get out of. Here's how we're different, and
          you can check every line of it.
        </p>
      </Reveal>
      <div class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2">
        {[
          { title: "Everything we build for you is yours.", body: "The Google Ads campaigns, the Meta campaigns, the landing pages, the conversion tracking. If you ever leave, all of it transfers to you in full." },
          { title: "Your ad budget is never marked up.", body: "Ad spend goes straight to Google or Meta at cost. You always know exactly what's our fee and what's your ads, down to the dollar." },
          { title: "We report leads, not clicks.", body: "Clear monthly reports on real calls and quote requests, and what each one cost. No impressions, no engagement, no fog." },
          { title: "No lock-in.", body: "One month's notice, and that month is about your money, not ours: it lets us clear any ad spend that's rolled over or catching up, so your account leaves clean." },
        ].map((c, i) => (
          <Reveal delay={i * 0.06} class="h-full">
            <div class="h-full rounded-box border border-white/10 surface-2 p-6">
              <p class="flex items-start gap-3 font-display text-xl text-neutral-content">
                <Icon name="check" class="mt-1 h-5 w-5 shrink-0 text-primary" /> {c.title}
              </p>
              <p class="mt-2 pl-8 text-neutral-content/70">{c.body}</p>
            </div>
          </Reveal>
        ))}
      </div>
      <Reveal delay={0.2} class="mx-auto mt-8 max-w-2xl text-center">
        <p class="text-neutral-content/80">
          When we took over <a href="/results/no-drips" class="link text-primary">No Drips' account</a>,
          the first thing we did was find close to $3,000 the previous agency had spent on clicks
          that were never going to book a job. Then we cut it.
        </p>
      </Reveal>
    </div>
  </section>

  <!-- ===== PROOF ===== -->
  <section class="bg-base-200 py-16 sm:py-24">
    <div class="mx-auto max-w-[1160px] px-5">
      <Reveal class="text-center">
        <span class="eyebrow">Proof</span>
        <h2 class="mt-3 text-3xl sm:text-5xl">Real Kiwi businesses. Real numbers.</h2>
      </Reveal>

      <!-- Featured case study: No Drips (trade-matched proof for a tradie audience).
           Stat-led, not quote-led: No Drips has no verified quote yet (slot is ready in
           their case-study page). Numbers come straight from /results/no-drips and are
           verifiable in the client's own account. -->
      <Reveal class="mt-12">
        <div class="card overflow-hidden border border-base-300 bg-base-100 shadow-md">
          <div class="card-body gap-8 p-7 sm:p-9 lg:flex-row lg:items-center">
            <!-- flex-wrap + smaller mobile numerals: two text-5xl stats side by side
                 overflowed the card on a 390px phone. -->
            <div class="flex shrink-0 flex-wrap gap-6 sm:gap-10 lg:flex-col lg:gap-8">
              <div>
                <div class="font-display text-4xl text-primary sm:text-6xl">$<span data-count="14">14</span></div>
                <div class="mt-1 text-sm text-base-content/60">a lead on their best keywords</div>
              </div>
              <div>
                <div class="font-display text-4xl text-base-content/80 sm:text-6xl">$<span data-count="45">45</span></div>
                <div class="mt-1 text-sm text-base-content/60">their cost-per-lead target</div>
              </div>
            </div>
            <div class="min-w-0">
              <span class="badge badge-primary font-display">Case study · Plumbing &amp; Gas</span>
              <p class="mt-3 font-display text-2xl">No Drips, Hawke's Bay plumbers and gasfitters.</p>
              <p class="mt-3 text-lg leading-relaxed text-base-content/80">
                We took over their Google Ads from another agency, found close to $3,000 spent on
                clicks that were never going to book a job, and cut it. Their best keywords now
                bring in leads for as little as $14 against a $45 target, and every lead we report
                is a real call or enquiry they can check in their own account.
              </p>
            </div>
            <div class="shrink-0 lg:self-center">
              <a href="/results/no-drips" class="btn btn-outline border-primary text-primary hover:bg-primary hover:text-primary-content">
                Read the full story <Icon name="arrow-right" class="h-4 w-4" />
              </a>
            </div>
          </div>
        </div>
      </Reveal>

      {/* Tableau Towbars removed 30/07/2026: its "up 69%" headline has no source data yet
          (CLAUDE.md TODO: "69%/+122% source data"). Restore once Matt produces the source. */}
      <div class="mt-6 grid grid-cols-1 gap-6 md:grid-cols-2">
        <Reveal>
          <div class="card card-glow h-full border border-base-300 bg-base-100 shadow-sm">
            <div class="card-body">
              <div class="flex items-start justify-end">
                <Icon name="quote" class="h-6 w-6 text-primary/30" />
              </div>
              <p class="text-xl font-bold">New customers booked months in advance.</p>
              <p class="text-base-content/70 italic">
                "Month after month, year after year Ryan, Matt and their team at Hyper Digital have
                allowed us the very fortunate position of having new customers booked months in
                advance for our Pools and Spas."
              </p>
              <div class="mt-2 flex items-center gap-3">
                <img src="/img/denise-bermuda-lifestyle-avatar.webp" alt="Denise Howell" width="96" height="96" loading="lazy" decoding="async" class="h-11 w-11 rounded-full object-cover" />
                <div>
                  <div class="font-display text-lg">Denise Howell</div>
                  <div class="text-sm text-base-content/60">Bermuda Lifestyle, Pools &amp; Spas</div>
                </div>
              </div>
            </div>
          </div>
        </Reveal>
        <Reveal delay={0.08}>
          <div class="card card-glow h-full border border-base-300 bg-base-100 shadow-sm">
            <div class="card-body">
              <div class="flex items-start justify-between">
                <div class="text-primary">★★★★★</div>
                <Icon name="quote" class="h-6 w-6 text-primary/30" />
              </div>
              <p class="text-xl font-bold">Cost per lead cut from $31 to around $17.</p>
              <p class="text-base-content/70 italic">
                "Harris Pumps and Filtration have been a client of Hyper Digital from the very
                beginning. A great company that has helped grow our online advertising with real
                results. They offer customised solutions that work."
              </p>
              <div class="mt-2 flex items-center gap-3">
                <img src="/img/harris-pumps-avatar.webp" alt="Harris Pumps &amp; Filtration" width="96" height="96" loading="lazy" decoding="async" class="h-11 w-11 rounded-full bg-neutral object-cover" />
